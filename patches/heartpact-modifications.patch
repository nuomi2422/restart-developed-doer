new file mode 100644
index 00000000..712a7b7c
--- /dev/null
+++ b/plugins/rdd/build.gradle
@@ -0,0 +1,38 @@
+plugins { id 'numen-plugin' }
+
+processResources {
+    def props = [
+            version                       : project.version,
+            license                       : license,
+            neoforge_loader_version_range : neoforge_loader_version_range,
+            neoforge_version              : neoforge_version,
+            minecraft_version_range       : minecraft_version_range
+    ]
+    inputs.properties props
+    filesMatching('META-INF/neoforge.mods.toml') {
+        expand props
+    }
+}
+
+dependencies {
+    // RDD 核心已独立为 rdd-core 模块；本插件只内嵌 rdd-core，不再内嵌 ac-core，
+    // 避免与 plugins/ac（AC 核心提供方）同装时出现重复包（JPMS ResolutionException）。
+    implementation project(':rdd-core')
+    // RddDecomposer / RddSubmitTool / RddDetector 用 Gson。
+    implementation 'com.google.code.gson:gson:2.10.1'
+    // 纯 JVM 容错解析(RddDecomposer.parse)需要 ai 模块的 IToolSpec 参与类加载。
+    testImplementation project(':ai')
+    testImplementation platform('org.junit:junit-bom:5.11.4')
+    testImplementation 'org.junit.jupiter:junit-jupiter'
+    testRuntimeOnly 'org.junit.platform:junit-platform-launcher'
+}
+
+test { useJUnitPlatform() }
+
+// The numen-plugin convention exposes host APIs as compileOnly. RDD's own
+// runtime must travel with the standalone plugin, otherwise RddRuntime would
+// only work in a development classpath and fail when invoked in a real game.
+tasks.named('jar', Jar) {
+    dependsOn(':rdd-core:jar')
+    from({ project(':rdd-core').sourceSets.main.output })
+}
diff --git a/plugins/rdd/src/main/java/com/dwinovo/numen/plugins/rdd/RddDecomposer.java b/plugins/rdd/src/main/java/com/dwinovo/numen/plugins/rdd/RddDecomposer.java

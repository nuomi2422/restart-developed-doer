+        for (AcEventListener l : eventListeners) invoke(() -> l.onEvent(event));
+    }
+
+    private void invoke(Runnable r) {
+        try {
+            r.run();
+        } catch (RuntimeException e) {
+            System.err.println("[ac-executor] listener error isolated: " + e);
+        }
     }
 }
